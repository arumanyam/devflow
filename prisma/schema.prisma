datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Issue {
  id          Int       @id @default(autoincrement())
  githubId    Int       @unique
  number      Int
  title       String
  body        String?
  status      String    // open | in_progress | blocked | closed
  assignee    String?
  labels      String?   // comma-separated, SQLite has no native array type
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // self-relation for "blocked by" dependencies
  dependsOn   Dependency[] @relation("IssueDependsOn")
  blocks      Dependency[] @relation("IssueBlocks")
}

model Dependency {
  id               Int    @id @default(autoincrement())
  issue            Issue  @relation("IssueDependsOn", fields: [issueId], references: [id])
  issueId          Int
  dependsOnIssue   Issue  @relation("IssueBlocks", fields: [dependsOnIssueId], references: [id])
  dependsOnIssueId Int

  @@unique([issueId, dependsOnIssueId])
}

model PullRequest {
  id           Int      @id @default(autoincrement())
  githubId     Int      @unique
  number       Int
  title        String
  author       String?
  status       String   // open | merged | closed
  diffSummary  String?  // Claude-generated summary
  riskFlag     String?  // low | medium | high, Claude-generated
  linkedIssue  Int?     // issue number this PR closes, if any
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SyncLog {
  id          Int      @id @default(autoincrement())
  source      String   // "poll" | "webhook"
  eventType   String?  // e.g. "pull_request.opened"
  status      String   // success | error
  message     String?
  createdAt   DateTime @default(now())
}
